    "tailwindcss-animate": "1.0.7",
    "ts-brand": "0.2.0",
    "vue": "3.5.13",
    "vue-number-animation": "2.0.2",
    "vue-router": "4.5.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@chromatic-com/storybook": "3.2.6",
