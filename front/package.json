{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "nuxt prepare",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "cleanup": "nuxt cleanup && nuxt prepare",
    "typecheck": "nuxt typecheck",
    "dev:https": "GQL_HOST=https://api-6zdezivzkq-ey.a.run.app nuxt dev --https --ssl-cert ../.certificates/localhost.pem --ssl-key ../.certificates/localhost-key.pem --host 127.0.0.1",
    "lint:fix": "bunx biome check --write",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "storybook:test:install": "bunx playwright install chromium --with-deps",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:test": "bunx concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"bun storybook build --quiet --docs  && bunx http-server storybook-static --port 6006 --silent\" \" bunx wait-on tcp:127.0.0.1:6006 && bun test-storybook --browsers chromium --maxWorkers=2\""
  },
  "dependencies": {
    "@iconify/vue": "4.3.0",
