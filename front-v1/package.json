{
  "name": "price-it-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "bunx biome check --write",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:test:install": "bunx playwright install chromium --with-deps",
    "storybook:build": "storybook build",
    "storybook:test": "bunx concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"bun storybook build --quiet --docs  && bunx http-server storybook-static --port 6006 --silent\" \"bunx wait-on tcp:127.0.0.1:6006 && bun test-storybook --browsers chromium --maxWorkers=2\"",
    "test:all": "bun storybook:test",
    "kill": "bunx lsof -t -i:6006 -i:4000 | xargs kill -9 "
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "1.1.8",
    "@telegram-apps/sdk-react": "3.1.2",
    "@tonconnect/ui-react": "2.0.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.479.0",
    "next": "15.2.2",
    "next-themes": "0.4.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "3.0.2",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@chromatic-com/storybook": "3.2.5",
    "@storybook/addon-a11y": "8.6.4",
    "@storybook/addon-essentials": "8.6.4",
    "@storybook/addon-interactions": "8.6.4",
    "@storybook/addon-links": "8.6.4",
    "@storybook/addon-onboarding": "8.6.4",
    "@storybook/addon-themes": "8.6.4",
    "@storybook/blocks": "8.6.4",
    "@storybook/nextjs": "8.6.4",
    "@storybook/react": "8.6.4",
    "@storybook/test": "8.6.4",
    "@storybook/test-runner": "0.22.0",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "cross-env": "7.0.3",
    "postcss": "8.5.3",
    "storybook": "8.6.4",
    "storybook-dark-mode": "4.0.2",
    "tailwindcss": "3.4.17",
    "ts-brand": "0.2.0",
    "typescript": "5.8.2"
  }
}
