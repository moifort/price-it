{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "onboarding": false,
  "platform": "github",
  "repositories": ["moifort/price-it"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^package.json$"],
      "matchStrings": ["firebase-tools@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "firebase-tools",
      "autoReplaceStringTemplate": "firebase-tools@{{{ newValue }}}"
    },
    {
      "customType": "regex",
      "fileMatch": ["^package.json$"],
      "matchStrings": ["bun@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "bun",
      "autoReplaceStringTemplate": "bun@{{{ newValue }}}"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/.*\\.yml$"],
      "matchStrings": ["bun-version: ['|\"]?(?<currentValue>\\d+\\.\\d+\\.\\d+)['|\"]?"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "bun",
      "autoReplaceStringTemplate": "bun-version: '{{{ newValue }}}'"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["node", "nuxt", "@telegram-apps/sdk-vue"],
      "enabled": false
    },
    {
      "groupName": "all non-major dependencies",
      "matchUpdateTypes": ["patch", "minor"],
      "groupSlug": "all-minor-patch",
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "enabled": true
    }
  ]
}
