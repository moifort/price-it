{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^package.json$"],
      "matchStrings": ["firebase-tools@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "firebase-tools",
      "replaceStringTemplate": "firebase-tools@{{{ newValue }}}"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["node", "nuxt", "@telegram-apps/sdk-vue"],
      "enabled": false
    },
    {
      "groupName": "all non-major dependencies",
      "matchUpdateTypes": ["patch", "minor"],
      "groupSlug": "all-minor-patch",
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "enabled": true
    }
  ]
}
